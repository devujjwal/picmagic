NEXT_PUBLIC_SITE_URL=https://picmagic.in
NEXT_PUBLIC_SITE_NAME=PicMagic
# Explicit seed mode for local development; production launch requires supabase.
CONTENT_SOURCE=seed
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
# Explicit HTTPS origins for admin uploads on trusted hosting previews (comma-separated).
ADMIN_ALLOWED_ORIGINS=
# Use the dedicated PicMagic web stream G-ID; blank disables analytics.
# Requires optional analytics consent. Disable Enhanced Measurement in GA4
# because the app sends sanitized pageviews and events itself.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
# Set true only after publisher/site setup and Google's consent message are configured.
# Google separately controls site approval and whether ads can serve.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
# JSON map of placement names to ad unit IDs created in AdSense; never invent IDs.
NEXT_PUBLIC_AD_SLOTS={}
